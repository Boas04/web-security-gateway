# No credentials here. Run setup.py to create per-installation secret files.
PUBLIC_ORIGIN=http://localhost:8090
# Compose fixes bindings to loopback. Never change to 0.0.0.0 for this lab.

# Local notification policy; monitor checks every 15 seconds.
ALERT_BLOCK_THRESHOLD=30
ALERT_WINDOW_SECONDS=60
ALERT_FAILURE_COUNT=2

# ML runs in ml-worker, review-only. No API key or external model service.
# Baseline approval, training and activation are performed in the admin dashboard.
